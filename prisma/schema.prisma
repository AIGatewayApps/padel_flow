generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  PLAYER
  COACH
  ORG_ADMIN
  VENDOR
  SUPER_ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum AdStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

model User {
  id            String         @id @default(cuid())
  clerkId       String         @unique
  email         String         @unique
  name          String?
  avatarUrl     String?
  role          Role           @default(PLAYER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orgMemberships OrgMember[]
  bookings      Booking[]
  sentMessages  Message[]      @relation("SentMessages")
  receivedMessages Message[]   @relation("ReceivedMessages")
  notifications Notification[]
  coachProfile  Coach?
  vendorProfile Vendor?
}

model Org {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  logoUrl     String?
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  members     OrgMember[]
  courts      Court[]
  events      Event[]
}

model OrgMember {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  role      Role     @default(PLAYER)
  joinedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
}

model Court {
  id          String    @id @default(cuid())
  orgId       String
  name        String
  description String?
  pricePerHour Float
  isIndoor    Boolean   @default(false)
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  org         Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bookings    Booking[]
}

model Booking {
  id        String        @id @default(cuid())
  userId    String
  courtId   String
  startTime DateTime
  endTime   DateTime
  status    BookingStatus @default(PENDING)
  totalCost Float
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  court     Court         @relation(fields: [courtId], references: [id], onDelete: Cascade)
}

model Event {
  id          String   @id @default(cuid())
  orgId       String
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  maxPlayers  Int?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model Coach {
  id          String   @id @default(cuid())
  userId      String   @unique
  bio         String?
  specialty   String?
  hourlyRate  Float?
  rating      Float?   @default(0)
  reviewCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  readAt     DateTime?
  createdAt  DateTime @default(now())
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  readAt    DateTime?
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Vendor {
  id          String    @id @default(cuid())
  userId      String    @unique
  storeName   String
  description String?
  logoUrl     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products    Product[]
  ads         Ad[]
}

model Product {
  id          String   @id @default(cuid())
  vendorId    String
  name        String
  description String?
  price       Float
  stock       Int      @default(0)
  imageUrl    String?
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model Ad {
  id          String        @id @default(cuid())
  vendorId    String
  title       String
  imageUrl    String?
  linkUrl     String?
  placement   String        @default("banner")
  status      AdStatus      @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?
  budget      Float?
  impressions AdImpression[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  vendor      Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model AdImpression {
  id        String   @id @default(cuid())
  adId      String
  userId    String?
  ipHash    String?
  clicked   Boolean  @default(false)
  createdAt DateTime @default(now())
  ad        Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
}
