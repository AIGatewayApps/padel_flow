generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  PLAYER
  COACH
  COURT_MANAGER
  EVENT_MANAGER
  VENDOR
  ADVERTISER
  ADMIN
}

enum OrgMemberRole {
  OWNER
  MANAGER
  STAFF
  VIEWER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  REFUNDED
}

enum FriendStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum MatchResult {
  WIN
  LOSS
  DRAW
}

enum ChallengeStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
}

enum RecurrenceType {
  NONE
  WEEKLY
  BIWEEKLY
}

enum SubscriptionTier {
  FREE
  PRO
}

enum AdType {
  FEED_BANNER
  COURT_SIDEBAR
  EVENT_SPOTLIGHT
  PUSH_SPONSORED
  LEADERBOARD_SPONSOR
}

enum AdStatus {
  PENDING_REVIEW
  ACTIVE
  PAUSED
  REJECTED
  COMPLETED
}

enum AuditAction {
  USER_BANNED
  USER_UNBANNED
  BOOKING_REFUNDED
  AD_APPROVED
  AD_REJECTED
  VENDOR_APPROVED
  VENDOR_REJECTED
  PRODUCT_REMOVED
  ORG_CREATED
  ORG_DELETED
  STAFF_INVITED
  STAFF_REMOVED
  ROLE_CHANGED
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id           String           @id
  email        String           @unique
  username     String           @unique
  displayName  String
  avatarUrl    String?
  bio          String?
  role         Role             @default(PLAYER)
  country      String?
  city         String?
  eloRating    Int              @default(1200)
  streak       Int              @default(0)
  lastPlayedAt DateTime?
  onboarded    Boolean          @default(false)
  subscription SubscriptionTier @default(FREE)
  bannedAt     DateTime?
  deletedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  profile             PlayerProfile?
  courtManager        CourtManagerProfile?
  eventManager        EventManagerProfile?
  coachProfile        Coach?
  vendorProfile       Vendor?
  settings            UserSettings?
  friendsInitiated    Friendship[]         @relation("initiator")
  friendsReceived     Friendship[]         @relation("receiver")
  messages            Message[]
  bookings            Booking[]
  orders              Order[]
  scores              Score[]              @relation("scoreUser")
  scoresAsOpponent    Score[]              @relation("scoreOpponent")
  coachHires          CoachHire[]          @relation("student")
  eventTickets        Ticket[]
  notifications       Notification[]
  posts               Post[]
  postLikes           PostLike[]
  postComments        PostComment[]
  postReactions       PostReaction[]
  challengesSent      MatchChallenge[]     @relation("challenger")
  challengesReceived  MatchChallenge[]     @relation("challenged")
  conversationMembers ConversationMember[]
  clubMemberships     ClubMember[]
  clubsOwned          Club[]               @relation("owner")
  liveScores          LiveScore[]
  pushSubscriptions   PushSubscription[]
  orgMemberships      OrgMember[]
  orgsOwned           Organization[]       @relation("orgOwner")
  coachReviews        CoachReview[]        @relation("reviewer")
  ads                 Ad[]
  adImpressions       AdImpression[]
  auditLogs           AuditLog[]           @relation("auditActor")
  waitlistEntries     EventWaitlist[]
}

// ─── Organization / Employee System ─────────────────────────────────────────

model Organization {
  id          String        @id @default(cuid())
  ownerId     String
  name        String
  slug        String        @unique
  logoUrl     String?
  plan        String        @default("FREE") // FREE | PRO | ENTERPRISE
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  owner       User          @relation("orgOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     OrgMember[]
  locations   OrgLocation[]
  ads         Ad[]

  @@index([ownerId])
  @@index([slug])
}

model OrgMember {
  id          String        @id @default(cuid())
  orgId       String
  userId      String
  role        OrgMemberRole @default(STAFF)
  permissions Json          @default("{}") // { "courts.manage": true, "reports.view": false, ... }
  locationIds String[]      // which OrgLocation IDs this member can access (empty = all)
  invitedAt   DateTime      @default(now())
  org         Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

model OrgLocation {
  id        String       @id @default(cuid())
  orgId     String
  name      String
  address   String
  city      String
  country   String
  lat       Float?
  lng       Float?
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  courts    Court[]
  events    Event[]

  @@index([orgId])
  @@index([city])
}

// ─── Profile Extensions ──────────────────────────────────────────────────────

model PlayerProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  racket      String?
  hand        String?
  position    String?
  ranking     Int?
  totalWins   Int     @default(0)
  totalLosses Int     @default(0)
  totalDraws  Int     @default(0)
}

model CourtManagerProfile {
  id          String       @id @default(cuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  taxId       String?
  courts      Court[]
}

model EventManagerProfile {
  id          String       @id @default(cuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  taxId       String?
  events      Event[]
}

model UserSettings {
  id                  String  @id @default(cuid())
  userId              String  @unique
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailBookings       Boolean @default(true)
  emailMessages       Boolean @default(true)
  emailMarketing      Boolean @default(false)
  pushBookings        Boolean @default(true)
  pushMessages        Boolean @default(true)
  pushFriendRequests  Boolean @default(true)
  profilePublic       Boolean @default(true)
  showLevel           Boolean @default(true)
  showLocation        Boolean @default(true)
  allowFriendRequests Boolean @default(true)
  language            String  @default("en")
  timezone            String  @default("UTC")
  theme               String  @default("system")
}

// ─── Social / Feed ───────────────────────────────────────────────────────────

model Friendship {
  id          String       @id @default(cuid())
  initiatorId String
  receiverId  String
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  initiator   User         @relation("initiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  receiver    User         @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([initiatorId, receiverId])
  @@index([receiverId])
}

model Post {
  id        String         @id @default(cuid())
  authorId  String
  body      String
  imageUrl  String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes     PostLike[]
  comments  PostComment[]
  reactions PostReaction[]

  @@index([authorId])
  @@index([createdAt(sort: Desc)])
}

model PostLike {
  id     String @id @default(cuid())
  postId String
  userId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model PostReaction {
  id     String @id @default(cuid())
  postId String
  userId String
  emoji  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, emoji])
  @@index([postId])
}

model PostComment {
  id        String        @id @default(cuid())
  postId    String
  authorId  String
  body      String
  parentId  String?
  createdAt DateTime      @default(now())
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    PostComment?  @relation("replies", fields: [parentId], references: [id])
  replies   PostComment[] @relation("replies")

  @@index([postId])
  @@index([authorId])
}

// ─── Clubs / Groups ──────────────────────────────────────────────────────────

model Club {
  id          String       @id @default(cuid())
  ownerId     String
  name        String
  description String?
  imageUrl    String?
  city        String?
  inviteCode  String       @unique @default(cuid())
  createdAt   DateTime     @default(now())
  owner       User         @relation("owner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     ClubMember[]
  posts       ClubPost[]

  @@index([ownerId])
}

model ClubMember {
  id       String   @id @default(cuid())
  clubId   String
  userId   String
  role     String   @default("member")
  joinedAt DateTime @default(now())
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId])
}

model ClubPost {
  id        String   @id @default(cuid())
  clubId    String
  authorId  String
  body      String
  imageUrl  String?
  createdAt DateTime @default(now())
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@index([createdAt(sort: Desc)])
}

// ─── Messages ────────────────────────────────────────────────────────────────

model Conversation {
  id        String               @id @default(cuid())
  createdAt DateTime             @default(now())
  messages  Message[]
  members   ConversationMember[]
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt(sort: Desc)])
}

// ─── Courts ──────────────────────────────────────────────────────────────────

model Court {
  id           String               @id @default(cuid())
  managerId    String
  locationId   String?
  name         String
  description  String?
  address      String
  city         String
  country      String
  lat          Float?
  lng          Float?
  imageUrl     String?
  pricePerHour Float
  surface      String?
  indoor       Boolean              @default(false)
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now())
  manager      CourtManagerProfile  @relation(fields: [managerId], references: [id], onDelete: Cascade)
  location     OrgLocation?         @relation(fields: [locationId], references: [id])
  slots        CourtSlot[]
  bookings     Booking[]
  liveScores   LiveScore[]

  @@index([managerId])
  @@index([city])
  @@index([locationId])
}

model CourtSlot {
  id           String         @id @default(cuid())
  courtId      String
  startsAt     DateTime
  endsAt       DateTime
  available    Boolean        @default(true)
  recurrence   RecurrenceType @default(NONE)
  priceOverride Float?        // peak/off-peak pricing override
  court        Court          @relation(fields: [courtId], references: [id], onDelete: Cascade)
  booking      Booking?

  @@index([courtId])
  @@index([startsAt])
}

model Booking {
  id          String        @id @default(cuid())
  userId      String
  courtId     String
  slotId      String        @unique
  status      BookingStatus @default(PENDING)
  totalAmount Float
  stripeId    String?
  cancelledAt DateTime?
  refundedAt  DateTime?
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  court       Court         @relation(fields: [courtId], references: [id], onDelete: Cascade)
  slot        CourtSlot     @relation(fields: [slotId], references: [id])

  @@index([userId])
  @@index([courtId])
  @@index([status])
}

// ─── Live Scores ─────────────────────────────────────────────────────────────

model LiveScore {
  id        String    @id @default(cuid())
  courtId   String?
  player1Id String
  player2Id String?
  sets      Json      @default("[]")
  isLive    Boolean   @default(true)
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  court     Court?    @relation(fields: [courtId], references: [id])
  player1   User      @relation(fields: [player1Id], references: [id], onDelete: Cascade)

  @@index([player1Id])
  @@index([isLive])
}

// ─── Scores & Leaderboard ────────────────────────────────────────────────────

model Score {
  id         String      @id @default(cuid())
  userId     String
  opponentId String?
  sets       Json
  result     MatchResult
  courtId    String?
  playedAt   DateTime    @default(now())
  user       User        @relation("scoreUser", fields: [userId], references: [id], onDelete: Cascade)
  opponent   User?       @relation("scoreOpponent", fields: [opponentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([opponentId])
  @@index([playedAt(sort: Desc)])
}

model MatchChallenge {
  id           String          @id @default(cuid())
  challengerId String
  challengedId String
  courtId      String?
  slotId       String?
  message      String?
  status       ChallengeStatus @default(PENDING)
  createdAt    DateTime        @default(now())
  challenger   User            @relation("challenger", fields: [challengerId], references: [id], onDelete: Cascade)
  challenged   User            @relation("challenged", fields: [challengedId], references: [id], onDelete: Cascade)

  @@index([challengerId])
  @@index([challengedId])
}

// ─── Coaches ─────────────────────────────────────────────────────────────────

model Coach {
  id              String              @id @default(cuid())
  userId          String              @unique
  bio             String?
  pricePerHour    Float
  certifications  String?
  specialties     String[]
  languages       String[]
  active          Boolean             @default(true)
  stripeAccountId String?
  avgRating       Float               @default(0)
  totalReviews    Int                 @default(0)
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  hires           CoachHire[]
  availability    CoachAvailability[]
  reviews         CoachReview[]
}

model CoachAvailability {
  id        String @id @default(cuid())
  coachId   String
  dayOfWeek Int
  startHour Int
  endHour   Int
  coach     Coach  @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId])
}

model CoachHire {
  id          String        @id @default(cuid())
  studentId   String
  coachId     String
  scheduledAt DateTime
  status      BookingStatus @default(PENDING)
  totalAmount Float
  stripeId    String?
  notes       String?
  sessionNotes String?      // coach notes added after session
  createdAt   DateTime      @default(now())
  student     User          @relation("student", fields: [studentId], references: [id], onDelete: Cascade)
  coach       Coach         @relation(fields: [coachId], references: [id], onDelete: Cascade)
  review      CoachReview?

  @@index([studentId])
  @@index([coachId])
}

model CoachReview {
  id        String    @id @default(cuid())
  coachId   String
  reviewerId String
  hireId    String    @unique
  rating    Int       // 1-5
  comment   String?
  createdAt DateTime  @default(now())
  coach     Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  reviewer  User      @relation("reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  hire      CoachHire @relation(fields: [hireId], references: [id])

  @@index([coachId])
}

// ─── Events & Tickets ────────────────────────────────────────────────────────

model Event {
  id          String               @id @default(cuid())
  managerId   String
  locationId  String?
  title       String
  description String?
  imageUrl    String?
  location    String
  startsAt    DateTime
  endsAt      DateTime
  ticketPrice Float                @default(0)
  capacity    Int?
  createdAt   DateTime             @default(now())
  manager     EventManagerProfile  @relation(fields: [managerId], references: [id], onDelete: Cascade)
  orgLocation OrgLocation?         @relation(fields: [locationId], references: [id])
  tickets     Ticket[]
  waitlist    EventWaitlist[]

  @@index([managerId])
  @@index([startsAt])
  @@index([locationId])
}

model Ticket {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  stripeId  String?
  qrCode    String?  @unique
  scanned   Boolean  @default(false)
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([userId])
}

model EventWaitlist {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  position  Int
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, position])
}

// ─── Shop / Marketplace ──────────────────────────────────────────────────────

model Vendor {
  id              String    @id @default(cuid())
  userId          String    @unique
  companyName     String
  logoUrl         String?
  website         String?
  stripeAccountId String?
  commissionPct   Float     @default(0.15) // platform takes 15% by default
  approved        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products        Product[]
  payouts         VendorPayout[]
}

model VendorPayout {
  id        String   @id @default(cuid())
  vendorId  String
  amount    Float
  stripeId  String?
  paidAt    DateTime @default(now())
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model Product {
  id            String      @id @default(cuid())
  vendorId      String?
  name          String
  description   String?
  imageUrl      String?
  price         Float
  stock         Int         @default(0)
  category      String?
  active        Boolean     @default(true)
  affiliateUrl  String?     // external link if not holding stock
  commissionPct Float?      // override vendor default
  createdAt     DateTime    @default(now())
  vendor        Vendor?     @relation(fields: [vendorId], references: [id])
  orderItems    OrderItem[]

  @@index([vendorId])
  @@index([category])
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  status    OrderStatus @default(PENDING)
  total     Float
  stripeId  String?
  address   Json?
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     OrderItem[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  qty       Int
  price     Float
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

// ─── Ads System ──────────────────────────────────────────────────────────────

model Ad {
  id           String       @id @default(cuid())
  advertiserId String
  orgId        String?
  title        String
  imageUrl     String?
  ctaText      String
  ctaUrl       String
  type         AdType
  status       AdStatus     @default(PENDING_REVIEW)
  budget       Float
  spent        Float        @default(0)
  cpm          Float        @default(5.0) // cost per 1000 impressions
  targeting    Json         @default("{}") // { city, country, minElo, maxElo, subscription }
  startsAt     DateTime?
  endsAt       DateTime?
  rejectionNote String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  advertiser   User         @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  org          Organization? @relation(fields: [orgId], references: [id])
  impressions  AdImpression[]

  @@index([advertiserId])
  @@index([status])
  @@index([type])
}

model AdImpression {
  id        String   @id @default(cuid())
  adId      String
  userId    String?
  clicked   Boolean  @default(false)
  createdAt DateTime @default(now())
  ad        Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([adId])
  @@index([createdAt])
}

// ─── Notifications ───────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  body      String
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

// ─── Push Subscriptions ──────────────────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Audit Log ───────────────────────────────────────────────────────────────

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String
  action     AuditAction
  targetType String      // "User" | "Ad" | "Vendor" | "Booking" etc.
  targetId   String
  meta       Json        @default("{}") // extra context
  createdAt  DateTime    @default(now())
  actor      User        @relation("auditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt(sort: Desc)])
}
